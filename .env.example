# ==========================================
# FRONTEND CONFIGURATION (Vite / React)
# ==========================================

# Port for the Frontend UI server
VITE_PORT=5173

# Host setting for network access:
# Set to 0.0.0.0 to allow devices on your local network (LAN) to access the frontend
VITE_HOST=0.0.0.0

# API Base URL for Frontend to connect to Backend
# For local machine testing: http://localhost:8000
# For network/LAN access: change localhost to your computer's LAN IP (e.g., http://192.168.1.10:8000)
VITE_API_BASE_URL=http://localhost:8000


# ==========================================
# BACKEND CONFIGURATION (FastAPI / Python)
# ==========================================

# Application Meta
APP_NAME=Faculty Timetable Extraction System
APP_VERSION=1.0.0
DEBUG=True

# Backend Host & Port Settings
# HOST=0.0.0.0 binds to all network interfaces (allows network access)
HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins
# Use * to allow requests from any network IP (e.g. mobile/other PCs), or list specific origins separated by commas
CORS_ORIGINS=*

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=faculty_timetable_db

# JWT Security
JWT_SECRET_KEY=your-super-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# Upload Settings
UPLOAD_DIR=uploads/pdf
MAX_UPLOAD_SIZE_MB=50

# Logging
LOG_FILE=logs/app.log
LOG_LEVEL=INFO
